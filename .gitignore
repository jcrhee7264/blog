# 이재천 장군 디지털 실록 웹 배포 .gitignore
# GitHub 단일 파일 100MB 초과 방지

# 100MB 초과 대용량 원본 비디오 (경량화된 _web.mp4는 배포에 포함)
assets/*_h264.mp4
assets/*_h265.mp4

# 살아있는 사료 영상 편집 중간본 (배포 미사용)
vidclip/사열식_화랑연병장(1968.1.27).mp4
vidclip/사열식_화랑연병장_0.5배속(1968.1.27).mp4
vidclip/사열식_화랑연병장_완전판(1968.1.27).mp4
vidclip/행진1.mp4
vidclip/행진2.mp4
vidclip/행진_화랑대_합본_마스터.mp4

# 대용량 사료 이미지 아카이브 (1.1GB 심볼릭 링크 분리)
images
images/

# OS 및 에디터 임시 파일
.DS_Store
Thumbs.db
*.tmp
